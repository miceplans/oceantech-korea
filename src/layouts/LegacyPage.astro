---
import type { LegacyPage } from '../lib/legacy-pages';

interface Props {
  page: LegacyPage;
}

const { page } = Astro.props;
const hasBoard = page.body.includes('class="oc-board');
const hasBoardList = page.body.includes('class="oc-board"');
const hasYearTabs = page.body.includes('e-n-tab-title');
---
<!doctype html>
<html lang={page.lang}>
  <head>
    <Fragment set:html={page.head} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/sun-typeface/SUIT@2/fonts/variable/woff2/SUIT-Variable.css" />
    {hasYearTabs && <script src="/year-tabs.js" defer is:inline></script>}
    {page.redirect && <meta http-equiv="refresh" content={`0;url=${page.redirect}`} />}
    {hasBoard && <link rel="stylesheet" href="/board.css" />}
    {hasBoardList && <script src="/board.js" defer is:inline></script>}
  </head>
  <body class={page.bodyClass}>
    {page.redirect ? <a href={page.redirect}>이동한 페이지 보기</a> : <Fragment set:html={page.body} />}
    {!page.redirect && <div class="ot-footer-ruler-wrap"><img class="ot-footer-ruler" src="/assets/2026/footer-ruler.webp" alt="" aria-hidden="true" width="6221" height="326" /></div>}
    <script is:inline>
      // Fallback for the missing Elementor Pro nav-menu handler chunk
      // (nav-menu.*.bundle.min.js was never crawled): burger toggle only;
      // submenus are always expanded via CSS.
      // Floating header: sticky at the top, translucent once scrolled.
      (function () {
        var header = document.querySelector('header.elementor-location-header');
        if (!header) return;
        function update() {
          header.classList.toggle('is-scrolled', window.scrollY > 40);
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();
      // Desktop: one shared panel under the menu bar. Size it to the first/last
      // top-level item and the tallest submenu column.
      document.querySelectorAll('nav.elementor-nav-menu--main').forEach(function (nav) {
        function sizePanel() {
          var items = nav.querySelectorAll(':scope > ul > li');
          if (!items.length) return;
          var navRect = nav.getBoundingClientRect();
          var first = items[0].getBoundingClientRect();
          var last = items[items.length - 1].getBoundingClientRect();
          var height = 0;
          nav.querySelectorAll('ul.sub-menu').forEach(function (ul) {
            var prev = ul.style.display;
            ul.style.display = 'block';
            height = Math.max(height, ul.offsetHeight);
            ul.style.display = prev;
          });
          // Full-viewport-width panel so it reads as an extension of the header bar.
          nav.style.setProperty('--mega-left', -navRect.left + 'px');
          nav.style.setProperty('--mega-w', document.documentElement.clientWidth + 'px');
          nav.style.setProperty('--mega-h', height + 'px');
          // The nav is vertically centered in a taller header bar; push the panel
          // down to the bar's bottom edge so it doesn't overlap the header.
          var bar = nav.closest('header.elementor-location-header > .e-parent.e-con') || nav.closest('header');
          var gap = bar ? Math.max(0, bar.getBoundingClientRect().bottom - navRect.bottom) : 0;
          nav.style.setProperty('--mega-top', gap + 'px');
        }
        nav.addEventListener('mouseover', sizePanel);
        nav.addEventListener('focusin', sizePanel);
      });
      document.querySelectorAll('.elementor-widget-nav-menu').forEach(function (widget) {
        var toggle = widget.querySelector('.elementor-menu-toggle');
        var dropdown = widget.querySelector('nav.elementor-nav-menu--dropdown');
        if (!toggle || !dropdown) return;
        toggle.addEventListener('click', function () {
          var open = dropdown.getAttribute('aria-hidden') === 'true';
          if (open) {
            // Elementor sizes the dropdown to the viewport via JS; do the same.
            var top = toggle.getBoundingClientRect().bottom;
            dropdown.style.position = 'fixed';
            dropdown.style.left = '0';
            dropdown.style.right = '0';
            dropdown.style.width = '100%';
            dropdown.style.top = top + 'px';
            dropdown.style.maxHeight = 'calc(100vh - ' + top + 'px)';
            dropdown.style.overflowY = 'auto';
            dropdown.style.zIndex = '9999';
          }
          dropdown.setAttribute('aria-hidden', open ? 'false' : 'true');
          toggle.classList.toggle('elementor-active', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      });
    </script>
  </body>
</html>

<style is:global>
  /* ---- Modern look: tokens ---- */
  :root {
    --ot-ink: #0b1f33;
    --ot-muted: #5b6b7b;
    --ot-brand: #0a4cc4;
    --ot-brand-2: #12b5d6;
    --ot-surface: #f5f8fc;
    --ot-line: #e3eaf2;
    --ot-radius: 16px;
    --ot-shadow: 0 1px 2px rgba(11, 31, 51, .04), 0 12px 32px -8px rgba(11, 31, 51, .12);
  }
  html { scroll-behavior: smooth; }
  ::selection { background: var(--ot-brand); color: #fff; }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    font-family: 'SUIT Variable', SUIT, -apple-system, BlinkMacSystemFont, 'Noto Sans KR', sans-serif;
    color: var(--ot-ink);
    letter-spacing: -.01em;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  body, body *:not(i):not([class*="fa-"]):not([class*="eicon"]):not([class*="icon"]) {
    font-family: 'SUIT Variable', SUIT, -apple-system, BlinkMacSystemFont, 'Noto Sans KR', sans-serif !important;
  }
  body :is(h1, h2, h3, .elementor-heading-title) { letter-spacing: -.025em; }

  /* Header: frosted glass bar with soft hairline */
  .elementor-location-header {
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, .78);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
  }
  .elementor-location-header .elementor-element { background-color: transparent; }
  .elementor-48 .elementor-element.elementor-element-981c368,
  .elementor-48 .elementor-element.elementor-element-0e9b431 {
    box-shadow: none;
    border-bottom: 1px solid rgba(11, 31, 51, .06);
  }
  .elementor-48 .elementor-element.elementor-element-c8ae8b5 .elementor-nav-menu--main > .elementor-nav-menu > .menu-item > .elementor-item {
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: .02em;
    color: var(--ot-ink);
    transition: background-color .2s, color .2s;
  }
  .elementor-48 .elementor-element.elementor-element-c8ae8b5 .elementor-nav-menu--main > .elementor-nav-menu > .menu-item > .elementor-item:is(:hover, :focus-visible, .elementor-item-active) {
    color: var(--ot-brand);
    background: rgba(10, 76, 196, .08);
  }
  .elementor-48 .elementor-element.elementor-element-c8ae8b5 .elementor-nav-menu--main .sub-menu {
    margin-top: 6px;
    padding: 8px;
    border: 1px solid var(--ot-line);
    border-radius: 14px;
    box-shadow: 0 20px 40px -12px rgba(11, 31, 51, .22);
    background: #fff;
  }
  .elementor-48 .elementor-element.elementor-element-c8ae8b5 .elementor-nav-menu--main .sub-menu .elementor-sub-item {
    border-radius: 8px;
    transition: background-color .15s, color .15s;
  }
  .elementor-48 .elementor-element.elementor-element-c8ae8b5 .elementor-nav-menu--main .sub-menu .elementor-sub-item:is(:hover, :focus-visible) {
    background: var(--ot-surface);
    color: var(--ot-brand);
  }

  /* Cards: image boxes and images */
  .elementor-widget-image-box .elementor-image-box-wrapper,
  .elementor-widget-image-box > .elementor-widget-container {
    border-radius: var(--ot-radius);
  }
  .elementor-widget-image-box > .elementor-widget-container {
    background: #fff;
    border: 1px solid var(--ot-line);
    box-shadow: var(--ot-shadow);
    padding: 24px;
    height: 100%;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .elementor-widget-image-box > .elementor-widget-container:hover {
    transform: translateY(-4px);
    box-shadow: 0 2px 4px rgba(11, 31, 51, .05), 0 24px 48px -12px rgba(10, 76, 196, .22);
  }

  /* Buttons & form controls */
  body :is(.elementor-button, .kboard-button-action, .kboard-default-button-small, button[type='submit'], input[type='submit']) {
    border-radius: 999px;
    font-weight: 600;
    transition: transform .15s, box-shadow .2s, background-color .2s;
  }
  body :is(.elementor-button, button[type='submit'], input[type='submit']):hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px -8px rgba(10, 76, 196, .45);
  }
  body :is(input[type='text'], input[type='search'], input[type='email'], select, textarea) {
    border: 1px solid var(--ot-line);
    border-radius: 10px;
    padding: 10px 14px;
    transition: border-color .15s, box-shadow .15s;
  }
  body :is(input, select, textarea):focus {
    outline: none;
    border-color: var(--ot-brand);
    box-shadow: 0 0 0 4px rgba(10, 76, 196, .12);
  }

  /* Board lists */
  body #kboard-default-list .kboard-list {
    border: 1px solid var(--ot-line);
    border-radius: var(--ot-radius);
    overflow: hidden;
    box-shadow: var(--ot-shadow);
    background: #fff;
  }
  body #kboard-default-list .kboard-list thead tr td {
    background: var(--ot-surface);
    font-weight: 700;
    border-bottom: 1px solid var(--ot-line);
  }
  body #kboard-default-list .kboard-list tbody tr { transition: background-color .15s; }

  /* Footer */
  .elementor-location-footer {
    background: var(--ot-ink);
    color: rgba(255, 255, 255, .75);
  }
  .elementor-location-footer :is(.elementor-element, .elementor-widget-container) { background-color: transparent; }
  .elementor-location-footer :is(h1, h2, h3, h4, .elementor-heading-title) { color: #fff; }
  .elementor-location-footer :is(p, li, span, .elementor-icon-list-text, .elementor-widget-text-editor) { color: rgba(255, 255, 255, .75); }
  .elementor-location-footer a,
  .elementor-location-footer a:visited { color: rgba(255, 255, 255, .9); transition: color .15s; }
  .elementor-location-footer a:hover { color: var(--ot-brand-2); }

  .ot-footer-ruler-wrap { background: #0B0B0B; padding: 24px 16px 0; }
  .ot-footer-ruler { display: block; width: min(100%, 720px); height: auto; margin: 0 auto; }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { transition: none !important; }
  }
  body > .elementor-location-footer {
    margin-top: auto;
  }

  /* Selected/hovered menu item: no color, pill background or underline; bold only. */
  .elementor-nav-menu--main .elementor-nav-menu a.elementor-item:is(:hover, :focus-visible, .elementor-item-active, .highlighted),
  .elementor-nav-menu--main .elementor-nav-menu a.elementor-sub-item:is(:hover, :focus-visible, .elementor-item-active) {
    color: inherit !important;
    background: transparent !important;
    font-weight: 800 !important;
  }
  .elementor-nav-menu--main .elementor-nav-menu a.elementor-item::before,
  .elementor-nav-menu--main .elementor-nav-menu a.elementor-item::after {
    display: none !important;
  }

  /* Floating header (Elementor sticky runtime is not available either). */
  header.elementor-location-header {
    position: sticky;
    top: 0;
    z-index: 9990;
    transition: top 0.25s ease;
  }
  /* Elementor's sticky script injects inline position:fixed/top/width on the
     container; neutralize it so the header's own sticky rule drives layout. */
  header.elementor-location-header > .e-parent.e-con {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }
  /* Material-book year tabs: the 2026 button's element id (26a8e1f1) has no
     width/color rule in the crawled CSS, so it collapsed. Match its siblings. */
  .elementor-9007 .elementor-element.elementor-element-26a8e1f1 { width: 100%; max-width: 100%; }
  .elementor-9007 .elementor-element.elementor-element-26a8e1f1 .elementor-button {
    background-color: var(--e-global-color-08d83bb);
    fill: #fff;
    color: #fff;
  }
  /* Elementor's sticky spacer clones would double the header height. */
  header.elementor-location-header > .elementor-sticky__spacer {
    display: none !important;
  }
  /* Scrolled: same full-width bar, flush to the top edge, just translucent.
     The header wrapper itself goes transparent so the layers don't stack. */
  header.elementor-location-header.is-scrolled {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  header.elementor-location-header.is-scrolled > .e-parent.e-con {
    background-color: rgba(255, 255, 255, 0.82) !important;
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    backdrop-filter: saturate(180%) blur(14px);
    box-shadow: 0 2px 16px rgba(11, 31, 51, 0.10) !important;
  }

  /* The Elementor Pro nav-menu handler chunk (nav-menu.*.bundle.min.js) is not
     available in this static export, so SmartMenus never initializes and
     `.elementor-nav-menu ul { display: none }` keeps every submenu hidden.
     Desktop: hovering the menu bar opens all submenus at once.
     Mobile: the burger dropdown always shows every submenu expanded. */
  @media (min-width: 1025px) {
    .elementor-nav-menu--main .elementor-nav-menu .menu-item-has-children {
      position: relative;
    }
    .elementor-nav-menu--main .elementor-nav-menu .menu-item-has-children > ul.sub-menu {
      top: calc(100% + var(--mega-top, 0px));
      inset-inline-start: 0;
      display: none;
      width: 100% !important;
      min-width: 0 !important;
      white-space: normal;
    }
    .elementor-nav-menu--main .elementor-nav-menu > li:last-child.menu-item-has-children > ul.sub-menu {
      inset-inline-start: auto;
      inset-inline-end: 0;
    }
    .elementor-nav-menu--main .elementor-nav-menu .menu-item-has-children > ul.sub-menu a {
      white-space: normal;
      padding-inline: 8px !important;
      word-break: keep-all;
    }
    .elementor-nav-menu--main {
      position: relative;
      isolation: isolate;
    }
    /* Equal-width top-level items so the submenu columns line up evenly. */
    .elementor-nav-menu--main .elementor-nav-menu > li.menu-item {
      flex: 0 1 168px;
      min-width: 0;
    }
    .elementor-nav-menu--main .elementor-nav-menu {
      flex-wrap: nowrap;
    }
    .elementor-nav-menu--main .elementor-nav-menu > li.menu-item > a {
      justify-content: center;
      text-align: center;
    }
    .elementor-nav-menu--main .elementor-nav-menu > li.menu-item > ul.sub-menu a {
      justify-content: flex-start;
      text-align: left;
    }
    .elementor-nav-menu--main:hover::before,
    .elementor-nav-menu--main:focus-within::before {
      content: '';
      position: absolute;
      top: calc(100% + var(--mega-top, 0px));
      left: var(--mega-left, 0);
      width: var(--mega-w, 100%);
      height: var(--mega-h, 0);
      background: rgba(255, 255, 255, 0.82);
      -webkit-backdrop-filter: saturate(180%) blur(14px);
      backdrop-filter: saturate(180%) blur(14px);
      border-radius: 0;
      border-top: 1px solid rgba(11, 31, 51, 0.06);
      box-shadow: 0 8px 16px -4px rgba(11, 31, 51, 0.12);
      z-index: -1;
    }
    /* Invisible hover bridge across the gap between the nav and the panel. */
    .elementor-nav-menu--main:hover::after,
    .elementor-nav-menu--main:focus-within::after {
      content: '';
      position: absolute;
      top: 100%;
      left: var(--mega-left, 0);
      width: var(--mega-w, 100%);
      height: var(--mega-top, 0);
    }
    .elementor-nav-menu--main .elementor-nav-menu .menu-item-has-children > ul.sub-menu {
      background: transparent !important;
      box-shadow: none !important;
      border: 0 !important;
      border-radius: 0 !important;
    }
    .elementor-nav-menu--main:hover .elementor-nav-menu .menu-item-has-children > ul.sub-menu,
    .elementor-nav-menu--main:focus-within .elementor-nav-menu .menu-item-has-children > ul.sub-menu {
      display: block;
      z-index: 9999;
    }
  }
  nav.elementor-nav-menu--dropdown.elementor-nav-menu__container[aria-hidden='true'] {
    display: none;
  }
  nav.elementor-nav-menu--dropdown.elementor-nav-menu__container[aria-hidden='false'] {
    display: block;
  }
  nav.elementor-nav-menu--dropdown .menu-item-has-children > ul.sub-menu {
    display: block;
    position: static;
    width: 100%;
  }
  nav.elementor-nav-menu--dropdown .sub-arrow {
    display: none;
  }
  /* Mobile dropdown: clean frosted panel, left-aligned groups, no shadows. */
  nav.elementor-nav-menu--dropdown {
    background: rgba(255, 255, 255, .96) !important;
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    box-shadow: 0 12px 24px -8px rgba(11, 31, 51, .18) !important;
    border-top: 1px solid var(--ot-line);
    padding: 8px 24px 24px;
  }
  nav.elementor-nav-menu--dropdown ul,
  nav.elementor-nav-menu--dropdown li,
  nav.elementor-nav-menu--dropdown a {
    box-shadow: none !important;
    background: transparent !important;
    border: 0 !important;
  }
  nav.elementor-nav-menu--dropdown .elementor-nav-menu > li {
    padding: 14px 0 10px;
    border-bottom: 1px solid var(--ot-line) !important;
  }
  nav.elementor-nav-menu--dropdown .elementor-nav-menu > li:last-child {
    border-bottom: 0 !important;
  }
  nav.elementor-nav-menu--dropdown .elementor-nav-menu > li > a.elementor-item {
    justify-content: flex-start !important;
    text-align: left !important;
    padding: 0 0 6px !important;
    font-size: 13px !important;
    font-weight: 800 !important;
    letter-spacing: .08em;
    color: var(--ot-brand) !important;
  }
  nav.elementor-nav-menu--dropdown ul.sub-menu a.elementor-sub-item {
    justify-content: flex-start !important;
    text-align: left !important;
    padding: 9px 0 !important;
    font-size: 16px !important;
    font-weight: 500 !important;
    color: var(--ot-ink) !important;
  }
  nav.elementor-nav-menu--dropdown ul.sub-menu a.elementor-sub-item:is(:hover, :active, .elementor-item-active) {
    font-weight: 800 !important;
  }
</style>
